HOST=127.0.0.1
PORT=4173
STYX_DB=data/styx.sqlite
# Local hosting profile; testnet execution is configured separately below.
STYX_MODE=local
# Optional password access; financial execution remains demo unless separately configured.
STYX_AUTH_MODE=local
# For a public reverse proxy use the exact HTTPS origin and password mode.
STYX_APP_ORIGIN=http://127.0.0.1:4173
# Optional private Backblaze B2 backups; never browser/VITE variables.
STYX_B2_ENABLED=false
STYX_B2_KEY_ID=
STYX_B2_APPLICATION_KEY=
STYX_B2_BUCKET_ID=
STYX_BACKUP_KEY_FILE=
# Optional live model. Each job also requires explicit external processing consent.
NEAR_AI_ENABLED=false
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# Optional NEAR testnet console. See docs/NEAR_TESTNET.md.
# Fresh v2 contract only; this never converts demo credits into NEAR.
NEAR_CONTRACT_ID=
NEAR_CONTRACT_CODE_HASH=
NEAR_AGENT_ACCOUNT_ID=
NEAR_AGENT_PRIVATE_KEY=
NEAR_VERIFIER_ACCOUNT_ID=
NEAR_VERIFIER_PRIVATE_KEY=
NEAR_LEDGERWORKS_ACCOUNT_ID=
NEAR_LEDGERWORKS_PRIVATE_KEY=
NEAR_LEDGERWORKS_PRICE_NEAR=
# Optional second provider; all accounts and keys must be distinct.
NEAR_PARSELAB_ACCOUNT_ID=
NEAR_PARSELAB_PRIVATE_KEY=
NEAR_PARSELAB_PRICE_NEAR=
