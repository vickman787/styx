{
  "name": "styx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "backup:run": "tsx scripts/backup-runner.ts",
    "backup:b2": "tsx scripts/backblaze.ts",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "db": "tsx scripts/database.ts",
    "access": "tsx scripts/access.ts",
    "access:setup": "powershell -NoProfile -File scripts/configure-access.ps1",
    "package:vps": "tsx scripts/package-vps.ts",
    "dev": "node --env-file-if-exists=data/near-testnet/app.env --env-file-if-exists=data/near-ai.env --import tsx server/index.ts",
    "testnet:setup": "tsx scripts/near-testnet-setup.ts",
    "test:contract:vm": "tsx scripts/near-vm-smoke.ts",
    "start": "node --env-file-if-exists=data/near-testnet/app.env --env-file-if-exists=data/near-ai.env --import tsx server/index.ts --production",
    "ai:setup": "powershell -NoProfile -File scripts/configure-ai.ps1",
    "ai:check": "node --env-file-if-exists=data/near-ai.env --import tsx scripts/check-ai.ts",
    "ai:smoke": "node --env-file-if-exists=data/near-ai.env --import tsx scripts/check-ai.ts --smoke",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:contract": "cargo test --manifest-path contracts/styx/Cargo.toml",
    "test:contract:sdk": "cargo test --manifest-path contracts/styx/Cargo.toml --features sdk-tests",
    "check:production": "tsx scripts/production-smoke.ts"
  },
  "overrides": {
    "@meteorwallet/sdk": {
      "nanoid": "5.1.16"
    }
  },
  "dependencies": {
    "@near-js/transactions": "2.5.1",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "buffer": "6.0.3",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "near-api-js": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
