# Install privately as /opt/styx/private/runtime.env; never serve real values.
HOST=0.0.0.0
STYX_CONTAINER=true
PORT=4173
STYX_AUTH_MODE=password
STYX_APP_ORIGIN=https://styx.example.invalid
STYX_DB=/var/lib/styx/styx.sqlite
STYX_MODE=local
# Add only reviewed restricted-role configuration from the active private app.env.
# Add the AI configuration separately only if enabling that paid integration.
# Never copy deployment.private.json or full-access/owner keys to the VPS.
